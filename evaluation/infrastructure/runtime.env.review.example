# REVIEW ONLY; not loaded by the application. All secrets absent.
# Production startup remains closed. One Render service, two post-fork workers.
ROSAGO_EVALUATION=true
ROSAGO_EVALUATION_PROJECT_REF=jfaufpfzfhysqkhcdsrs
SUPABASE_URL=https://jfaufpfzfhysqkhcdsrs.supabase.co
ROSAGO_AUTH_MODE=production
ROSAGO_EVALUATION_TRANSPORT=managed-proxy
ROSAGO_EVALUATION_PROXY_HOPS=1
ROSAGO_EVALUATION_EMAIL_MODE=disabled
ROUTING_PROVIDER=disabled
# Separately supplied after approvals and actual proxy validation:
# SUPABASE_KEY: pinned public evaluation key
# ROSAGO_PUBLIC_ORIGIN: exact assigned Render HTTPS origin
# ROSAGO_PROXY_HEADERS_SANITIZED: never true before real edge qualification
# FLASK_SECRET_KEY: private fresh evaluation secret
# ROSAGO_SESSION_DATABASE_URL: dedicated session role, verified TLS, small pool
# ROSAGO_SESSION_KEYRING: private evaluation-only encryption keys
# ROSAGO_SESSION_NAMESPACE, ROSAGO_USER_SESSION_EPOCH, ROSAGO_ADMIN_SESSION_EPOCH
# ROSAGO_AUTHORITY_URL: exact HTTPS authority endpoint /v1/authority
# ROSAGO_AUTHORITY_CLIENT_TOKEN: application-scoped secret only
# ROSAGO_AUTHORITY_ID, ROSAGO_AUTHORITY_INCARNATION, ROSAGO_AUTHORITY_MIN_SEQUENCE
# Never import production environment groups, service_role keys, or Cloudflare
# account API/operator tokens. These proposed new variables have no loader yet.
